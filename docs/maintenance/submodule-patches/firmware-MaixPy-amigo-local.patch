+    def set_screen_brightness(self, brightness):
+        """Sets the screen brightness through AXP173 LDO2/3 voltage."""
+        if brightness > 15 or brightness < 0:
+            raise OutOfRange("Range for brightness is from 0 to 15")
+        brightness = int(brightness) & 0x0F
+        self.__write_register(
+            AXP173_LDO_2_3_VOLTAGE_REG, (brightness << 4) | brightness
+        )
+
     def enter_sleep_mode(self):
         """Actually it won't sleep, it will shutdown instead."""
         self.__write_register(AXP173_SHUTDOWN_SETTINGS, 0xC0) # Shuts down all outputs
